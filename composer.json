{
    "name": "nanopub/nanopub",
    "description": "Lightweight federated social network server implementing ActivityPub protocol",
    "type": "project",
    "keywords": [
        "activitypub",
        "fediverse",
        "mastodon",
        "social-network",
        "federation",
        "microblog"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "NanoPub Contributors"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "ext-fileinfo": "*",
        "ext-intl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "NanoPub\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NanoPub\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "lint": "phpcs --standard=PSR12 src/",
        "lint:fix": "phpcbf --standard=PSR12 src/",
        "analyse": "phpstan analyse src --level=5",
        "build-release": "bash scripts/build-release.sh"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "prefer-stable": true
}